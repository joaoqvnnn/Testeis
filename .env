# Token do seu Bot do Telegram (obtido com o @BotFather)
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# SEU ID de Telegram (coloque o seu ID numérico aqui para ser o Admin)
ADMIN_TELEGRAM_ID=SEU_ID_NUMERICO_AQUI

# Access Token de PRODUÇÃO do Mercado Pago (para saques reais)
MERCADOPAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN_DE_PRODUCAO_AQUI

# URL pública do seu webhook (ex: https://seu-dominio.com/webhook)
# Para testes locais, use o Ngrok para gerar uma URL pública e coloque aqui
WEBHOOK_URL=https://seu-dominio.com/webhook
